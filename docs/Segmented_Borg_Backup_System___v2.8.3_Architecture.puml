@startuml
' ============================================
' DIAGRAM SETTINGS
' ============================================
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontSize 12
skinparam Padding 8
skinparam ActivityBackgroundColor #LightYellow
skinparam ActivityBorderColor #222222
skinparam ArrowColor #222222
skinparam PartitionBorderColor #222222
skinparam NoteBorderColor #222222
skinparam NoteBackgroundColor #F7F2B8

title Segmented Borg Backup System v2.8.3 - Complete Architecture & Flow

' ============================================
' LEGEND
' ============================================
legend top
    |= Color |= Scope |
    | <#LightYellow> | Universal (both profiles) |
    | <#PaleGreen> | system profile only |
    | <#LightSalmon> | dev-data profile only |
    | <#LightBlue> | Systemd Layer |
    | <#Lavender> | Configuration |
    | <#LightCoral> | External Systems |
endlegend

' ============================================
' START
' ============================================
start

' ============================================
' SYSTEMD TRIGGER
' ============================================
partition "**Systemd Layer**" #LightBlue {
    :backup-system.timer / backup-dev-data.timer;
    :backup-system.service / backup-dev-data.service;
    note right
        **Pending Fix:**
        Dedicated .mount units
        for both profiles
    end note
}

' ============================================
' CONFIGURATION LOADING
' ============================================
partition "**Configuration**" #Lavender {
    :Load **common.env** (v2.8.3)
    Base settings, Borg compression, timeouts;
    :Load **secrets.env**
    BORG_PASSPHRASE, SHELLY_IP, DB credentials,
    UUIDs, system-specific paths;
    if (--profile=?) then (system)
        :Load **system.env** (v2.8.0)
        SHELLY_ENABLED=true
        DOCKER_ENABLED=false;
    else (dev-data)
        :Load **dev-data.env** (v2.0.0)
        SHELLY_ENABLED=false
        DOCKER_ENABLED=true
        NEXTCLOUD_ENABLED=true;
    endif
}

' ============================================
' ORCHESTRATOR
' ============================================
partition "**Orchestrator (main.sh)**" #LightGreen {
    :run_backup.sh --profile=<name>;
}

' ============================================
' PRE_BACKUP_SEGMENTS
' ============================================
partition "**1. PRE_BACKUP_SEGMENTS**" {
    if (profile?) then (dev-data)
        #LightSalmon:pre_01_nextcloud_db_dump.sh
        ← Nextcloud maintenance mode + mysqldump;
        #LightSalmon:pre_02_docker_stop.sh
        ← Graceful container shutdown;
    else (system)
        :( skipped );
    endif
}

' ============================================
' MAIN_SEGMENTS_PART1
' ============================================
partition "**2. MAIN_SEGMENTS_PART1**" #LightYellow {
    :01_validate_config.sh;
    :02_init_logging.sh;
    :03_shelly_power_on.sh
    → Shelly Smart Plug (system only);
    :04_wait_device.sh;
    :05_mount_backup.sh
    → USB HDD (system) / SATA (dev-data);
    :06_validate_mount.sh;
    :07_init_borg_repo.sh
    → Borg Repository;
    :08_borg_backup.sh
    → borg create;
}

' ============================================
' POST_BACKUP_SEGMENTS
' ============================================
partition "**3. POST_BACKUP_SEGMENTS**" {
    note right
        **Downtime Optimization:**
        Docker restarts HERE
        (before verify/prune)
    end note
    
    if (profile?) then (dev-data)
        #LightSalmon:post_01_docker_start.sh
        ← Restart containers NOW;
        #LightSalmon:post_02_export_recovery_keys.sh;
    else (system)
        #PaleGreen:post_01_export_recovery_keys.sh;
    endif
}

' ============================================
' MAIN_SEGMENTS_PART2
' ============================================
partition "**4. MAIN_SEGMENTS_PART2**" #LightYellow {
    :09_borg_verify.sh
    → borg check (runs while services online);
    :10_borg_prune.sh
    → borg prune;
}

' ============================================
' CLEANUP_SEGMENTS (via trap)
' ============================================
partition "**5. CLEANUP_SEGMENTS** (via trap)" #LightYellow {
    :11_hdd_spindown.sh;
    :12_unmount_backup.sh;
    :13_shelly_power_off.sh
    → Shelly Smart Plug (system only);
}

' ============================================
' POST_CLEANUP_SEGMENTS
' ============================================
partition "**6. POST_CLEANUP_SEGMENTS**" {
    :(currently empty for both profiles);
}

' ============================================
' EXTERNAL SYSTEMS SUMMARY
' ============================================
partition "**External Systems**" #LightCoral {
    note
        **Hardware:**
        • Shelly Smart Plug (system only)
        • USB HDD /dev/disk/by-uuid/... (system)
        • Internal SATA (dev-data)
        
        **Services:**
        • Docker Containers (dev-data only)
        • Nextcloud + MariaDB (dev-data only)
        • Borg Repository (both)
    end note
}

' ============================================
' END
' ============================================
stop
@enduml