@startuml
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontSize 13
skinparam Padding 10
skinparam nodesep 40
skinparam ranksep 35

skinparam ArrowColor #222222
skinparam NoteBorderColor #222222
skinparam NoteBackgroundColor #F7F2B8

title Segmented Borg Backup System v2.8.3\nExecution Flow (incl. Systemd Mount Units Fix)

' ============================================
' LEGEND
' ============================================
legend top
    |= Color |= Meaning |
    | <#LightBlue> | Systemd Layer |
    | <#LightGreen> | Orchestration |
    | <#LightYellow> | Main Segments (universal) |
    | <#PaleGreen> | system profile only |
    | <#LightSalmon> | dev-data profile only |
    | <#LightCoral> | External Systems |
    | <#Lavender> | Configuration |
    | <#Orange> | Pending Fix |
endlegend

' ============================================
' SYSTEMD + CONFIG
' ============================================
together {
    package "Systemd Layer" as systemd #LightBlue {
        [backup-system.timer] as timer_sys
        [backup-dev-data.timer] as timer_dev
        [backup-system.service] as svc_sys
        [backup-dev-data.service] as svc_dev
        
        package "Mount Units (FIX)" #Orange {
            [mnt-backup-next.mount] as mount_sys
            [mnt-backup-dev.mount] as mount_dev
        }
        
        timer_sys --> svc_sys
        timer_dev --> svc_dev
        svc_sys ..> mount_sys
        svc_dev ..> mount_dev
    }

    package "Configuration" as config #Lavender {
        [common.env] as common
        [secrets.env] as secrets
        [system.env] as prof_sys
        [dev-data.env] as prof_dev
    }
}

' ============================================
' ORCHESTRATOR
' ============================================
package "Orchestrator" #LightGreen {
    [run_backup.sh] as runner
}

' ============================================
' PRE_BACKUP_SEGMENTS (profile-specific)
' ============================================
package "1. PRE_BACKUP_SEGMENTS" as pre_phase {

    package "dev-data" as pre_dev #LightSalmon {
        [pre_01_nextcloud_db_dump] as seg_pre01
        [pre_02_docker_stop] as seg_pre02
        seg_pre01 --> seg_pre02
    }
}

' ============================================
' MAIN_SEGMENTS_PART1 (01-08)
' ============================================
package "2. MAIN_SEGMENTS_PART1 (universal)" as main_part1 #LightYellow {
    [01_validate_config] as seg01
    [02_init_logging] as seg02
    [03_shelly_power_on] as seg03
    [04_wait_device] as seg04
    [05_mount_backup] as seg05
    [06_validate_mount] as seg06
    [07_init_borg_repo] as seg07
    [08_borg_backup] as seg08
    
    seg01 --> seg02
    seg02 --> seg03
    seg03 --> seg04
    seg04 --> seg05
    seg05 --> seg06
    seg06 --> seg07
    seg07 --> seg08
}

' ============================================
' POST_BACKUP_SEGMENTS (profile-specific)
' Runs AFTER backup, BEFORE verify!
' ============================================
package "3. POST_BACKUP_SEGMENTS" as post_backup {
    package "system" as post_sys #PaleGreen {
        [post_01_export_recovery_keys] as post_sys_keys
    }
    package "dev-data" as post_dev #LightSalmon {
        [post_01_docker_start] as post_docker
        [post_02_export_recovery_keys] as post_dev_keys
        post_docker --> post_dev_keys
    }
}

note right of post_backup
    **Downtime Optimization:**
    Docker restarts HERE
    (before verify/prune)
    → Services back online
    while verify still runs
end note

' ============================================
' MAIN_SEGMENTS_PART2 (09-10)
' ============================================
package "4. MAIN_SEGMENTS_PART2 (universal)" as main_part2 #LightYellow {
    [09_borg_verify] as seg09
    [10_borg_prune] as seg10
    
    seg09 --> seg10
}

' ============================================
' CLEANUP_SEGMENTS (11-13, via trap)
' ============================================
package "5. CLEANUP_SEGMENTS (via trap)" as cleanup #LightYellow {
    [11_hdd_spindown] as seg11
    [12_unmount_backup] as seg12
    [13_shelly_power_off] as seg13
    
    seg11 --> seg12
    seg12 --> seg13
}

' ============================================
' POST_CLEANUP_SEGMENTS (profile-specific)
' ============================================
package "6. POST_CLEANUP_SEGMENTS" as post_cleanup {
    package "system" as cleanup_sys #PaleGreen {
        [( empty )] as cleanup_sys_empty
    }
    package "dev-data" as cleanup_dev #LightSalmon {
        [( empty )] as cleanup_dev_empty
    }
}

' ============================================
' EXTERNAL SYSTEMS
' ============================================
package "Hardware" as hw #LightCoral {
    [Shelly Plug] as shelly
    [USB HDD] as usb_hdd
    [SATA Drive] as sata
}

package "Services" as svc #LightCoral {
    [Docker] as docker
    [Nextcloud] as nextcloud
    [Borg Repo] as borg_repo
}

' ============================================
' FLOW CONNECTIONS
' ============================================
svc_sys --> runner
svc_dev --> runner
common --> runner
secrets --> runner
prof_sys --> runner
prof_dev --> runner

' PRE phase
runner --> pre_empty : system
runner --> seg_pre01 : dev-data

' PRE → MAIN_PART1
pre_empty --> seg01
seg_pre02 --> seg01

' MAIN_PART1 → POST_BACKUP
seg08 --> post_sys_keys : system
seg08 --> post_docker : dev-data

' POST_BACKUP → MAIN_PART2
post_sys_keys --> seg09
post_dev_keys --> seg09

' MAIN_PART2 → CLEANUP
seg10 --> seg11

' CLEANUP → POST_CLEANUP
seg13 --> cleanup_sys_empty : system
seg13 --> cleanup_dev_empty : dev-data

' ============================================
' EXTERNAL CONNECTIONS
' ============================================
seg03 ..> shelly : Power On
seg05 ..> usb_hdd : mount (system)
seg05 ..> sata : mount (dev-data)
seg_pre01 ..> nextcloud : maintenance + dump
seg_pre02 ..> docker : stop
post_docker ..> docker : start
seg08 ..> borg_repo : borg create
seg09 ..> borg_repo : borg check
seg10 ..> borg_repo : borg prune
seg13 ..> shelly : Power Off

mount_sys ..> usb_hdd
mount_dev ..> sata

' ============================================
' PROFILE COMPARISON
' ============================================
note bottom
    **Profile Comparison v2.8.3:**
    | Phase | system | dev-data |
    | PRE_BACKUP | (empty) | db_dump → docker_stop |
    | MAIN_PART1 | 01-08 | 01-08 |
    | POST_BACKUP | export_keys | docker_start → export_keys |
    | MAIN_PART2 | 09-10 | 09-10 |
    | CLEANUP | 11-13 | 11-13 |
    | POST_CLEANUP | (empty) | (empty) |
    
    | Hardware | system | dev-data |
    | Target | USB HDD | SATA |
    | Shelly | Yes | No |
    | Docker | No | Yes |
end note
@enduml