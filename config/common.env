#!/usr/bin/env bash
# common.env
# @version 2.9.0
# @description Common configuration shared across all backup profiles (no secrets!)
# @author Jo Zapf
# @changed 2026-02-09 - Version 2.9.0: Fixed execution order, mount hardening
# @changed 2026-02-04 - Version 2.8.3: Mount/unmount error recovery with process safety
# @changed 2026-01-26 - Version 2.8.2: Fixed stacked mounts via direct mount (no automount)
# @changed 2026-01-25 - Version 2.8.1: Mount-point protection and validation enhancements
# @changed 2026-01-22 - Version sync: Updated to v2.7.3

# ============================================================================
# SYSTEM VERSION
# ============================================================================
export BACKUP_SYSTEM_VERSION="2.9.0"

# ============================================================================
# HARDWARE CONTROL - Shelly Plug Plus
# ============================================================================
# Note: SHELLY_IP moved to secrets.env
export SHELLY_TOGGLE_AFTER_SEC="43200"          # 12 hours auto-off timeout
export DEVICE_WAIT_SECONDS="180"                # Wait time for device availability

# ============================================================================
# MOUNT CONFIGURATION
# ============================================================================
# Note: BACKUP_MNT moved to secrets.env (system-specific mount point)

# ============================================================================
# BORG SETTINGS
# ============================================================================
# Note: BORG_PASSPHRASE moved to secrets.env (was in /root/.config/borg/passphrase)
export BORG_COMPRESSION="zstd,6"                # Compression algorithm and level
export BORG_LOCK_WAIT="60"                      # Lock wait timeout in seconds

# ============================================================================
# LOGGING
# ============================================================================
# Note: LOCAL_LOG_DIR moved to secrets.env (system-specific path)
export BACKUP_LOG_SUBDIR="logs"                 # Subdir in backup target for logs

# ============================================================================
# RECOVERY KEY EXPORT
# ============================================================================
# Note: RECOVERY_ZIP_PASSWORD, RECOVERY_DIR, RECOVERY_OWNER moved to secrets.env
export RECOVERY_ENABLED="true"                  # Enable/disable recovery key export

# ============================================================================
# RUNTIME STATE (populated by segments)
# ============================================================================
export LOCAL_LOG=""                             # Set by init_logging segment
export BACKUP_LOG=""                            # Set when mount successful
export TIMESTAMP=""                             # Set by init_logging segment
