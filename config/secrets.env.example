#!/usr/bin/env bash
# secrets.env.example
# @version 2.0.0
# @description Example template for centralized secrets management
# @author Jo Zapf
# @created 2026-01-21
# @changed 2026-01-21 - Added all system-specific paths and profile secrets
# @note Copy to secrets.env and replace placeholder values with actual secrets

# ============================================================================
# INSTRUCTIONS
# ============================================================================
# 1. Copy this file: cp secrets.env.example secrets.env
# 2. Replace all placeholder values with your actual secrets
# 3. Set permissions: chmod 600 secrets.env
# 4. Verify ownership: chown root:root secrets.env
# 5. NEVER commit secrets.env to Git (it's in .gitignore)!

# ============================================================================
# BORG BACKUP CREDENTIALS
# ============================================================================
# Borg repository encryption passphrase
# Used by all profiles for repository encryption
# SECURITY: This is the master key for your encrypted backups!
#           Without this passphrase, backups are unrecoverable!
#           Store a backup copy in a password manager or secure location!
export BORG_PASSPHRASE="REPLACE-WITH-YOUR-BORG-PASSPHRASE"

# ============================================================================
# HARDWARE CREDENTIALS
# ============================================================================
# Shelly Plug IP address (for external HDD power control)
# Used by: system profile (segments 03_shelly_power_on.sh, 13_shelly_power_off.sh)
# Format: IPv4 address (e.g., 192.168.1.100)
export SHELLY_IP="192.168.X.X"

# ============================================================================
# SYSTEM PATHS (User/Host-Specific)
# ============================================================================
# Mount point for backup device (used by system profile)
# Update with your actual mount point
# Used by: segments 05_mount_device.sh, 06_validate_mount.sh, 12_unmount_device.sh
export BACKUP_MNT="/mnt/extern_backup"

# Local log directory
# Used by: segments/02_init_logging.sh
export LOCAL_LOG_DIR="/var/log/extern_backup"

# Recovery archive storage directory
# Update with your actual home directory path
# Used by: segments/post_*_export_recovery_keys.sh
export RECOVERY_DIR="/home/user/Projekte/segmented-borg-backup-system/recovery"

# File ownership for recovery archives (user:group)
# Update with your actual username and group
# Used by: segments/post_*_export_recovery_keys.sh
export RECOVERY_OWNER="user:user"

# ============================================================================
# SYSTEM PROFILE - Hardware & Paths
# ============================================================================
# Backup device UUID (external USB HDD)
# Find with: lsblk -o NAME,UUID
# Used by: segments 04_wait_for_device.sh, 05_mount_device.sh
export SYSTEM_BACKUP_UUID="XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"

# Backup sources (semicolon-separated)
# Example: "/;/boot/efi" for full system backup
# Used by: segments 01_validate_config.sh, 08_borg_backup.sh
export SYSTEM_BACKUP_SOURCES="/;/boot/efi"

# Target directory on backup device (contains hostname)
# Example: /mnt/extern_backup/hostname_nvme0n1_System
# Used by: All Borg segments (07, 08, 09, 10, POST_BACKUP)
export SYSTEM_TARGET_DIR="${BACKUP_MNT}/hostname_nvme0n1_System"

# Archive naming prefix (contains hostname)
# Example: hostname-nvme0n1-system
# Used by: segments 08_borg_backup.sh, 10_borg_prune.sh
export SYSTEM_ARCHIVE_PREFIX="hostname-nvme0n1-system"

# ============================================================================
# DEV-DATA PROFILE - Hardware & Paths
# ============================================================================
# Backup device UUID (internal SATA HDD)
# Find with: lsblk -o NAME,UUID
# Used by: segments 04_wait_for_device.sh, 05_mount_device.sh
export DEVDATA_BACKUP_UUID="XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"

# Mount point for dev-data backup device (different from system!)
# Used by: segments 05_mount_device.sh, 06_validate_mount.sh, 12_unmount_device.sh
export DEVDATA_BACKUP_MNT="/mnt/system_backup"

# Backup sources
# Used by: segments 01_validate_config.sh, 08_borg_backup.sh
export DEVDATA_BACKUP_SOURCES="/mnt/docker-data"

# HDD device for spindown
# Find with: lsblk -o NAME,TYPE
# Used by: segments/11_hdd_spindown.sh
export DEVDATA_HDD_DEVICE="/dev/sda"

# Target directory on backup device (contains hostname)
# Used by: All Borg segments
export DEVDATA_TARGET_DIR="${DEVDATA_BACKUP_MNT}/hostname_docker-data"

# Archive naming prefix (contains hostname)
# Used by: segments 08_borg_backup.sh, 10_borg_prune.sh
export DEVDATA_ARCHIVE_PREFIX="hostname-docker-data"

# ============================================================================
# NEXTCLOUD / DATABASE CREDENTIALS
# ============================================================================
# Nextcloud database password
# Used by: segments/pre_01_nextcloud_db_dump.sh (dev-data profile)
# Must match the password configured in your Nextcloud database container
export NEXTCLOUD_DB_PASSWORD="REPLACE-WITH-YOUR-DB-PASSWORD"

# Nextcloud database name
# Default: nextcloud (update if using custom name)
# Used by: segments/pre_01_nextcloud_db_dump.sh
export NEXTCLOUD_DB_NAME="nextcloud"

# Nextcloud database user
# Default: ncadmin (update if using custom user)
# Used by: segments/pre_01_nextcloud_db_dump.sh
export NEXTCLOUD_DB_USER="ncadmin"

# Nextcloud Docker container names
# Update if using custom container names
# Used by: segments/pre_01_nextcloud_db_dump.sh
export NEXTCLOUD_DOCKER_APP_CONTAINER="nextcloud-app"
export NEXTCLOUD_DOCKER_DB_CONTAINER="nextcloud-db"

# ============================================================================
# RECOVERY / EXPORT CREDENTIALS
# ============================================================================
# Password for recovery key ZIP archives
# Used by: segments/post_*_export_recovery_keys.sh (all profiles)
# Optional: Leave empty for unencrypted ZIPs (not recommended)
export RECOVERY_ZIP_PASSWORD="REPLACE-WITH-YOUR-ZIP-PASSWORD"

# ============================================================================
# SECURITY NOTES
# ============================================================================
# This file contains all secrets for the backup system.
# 
# Required security measures:
# - File permissions: chmod 600 (read/write only by owner)
# - File ownership: chown root:root (owned by root)
# - Git exclusion: Must be in .gitignore (NEVER commit!)
# - Backup: Store encrypted copy in safe location
# 
# Verification commands:
#   ls -la /opt/backup-system/config/secrets.env
#   # Should show: -rw------- 1 root root
#
#   git status
#   # Should NOT show secrets.env as modified/untracked
#
# Backup recommendations:
# 1. Password manager (BitWarden, LastPass, 1Password)
# 2. Encrypted USB drive (stored offsite)
# 3. Encrypted cloud storage (Nextcloud, Dropbox with GPG)
# 4. Paper copy in safe/lockbox (for disaster recovery)
#
# ⚠️ CRITICAL: Without secrets.env backup, encrypted repositories are lost!
