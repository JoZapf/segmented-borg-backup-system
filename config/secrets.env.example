#!/usr/bin/env bash
# secrets.env.example
# @version 1.0.0
# @description Example template for centralized secrets management
# @author Jo Zapf
# @created 2026-01-21
# @note Copy to secrets.env and replace placeholder values with actual secrets

# ============================================================================
# INSTRUCTIONS
# ============================================================================
# 1. Copy this file: cp secrets.env.example secrets.env
# 2. Replace all placeholder values with your actual secrets
# 3. Set permissions: chmod 600 secrets.env
# 4. Verify ownership: chown root:root secrets.env
# 5. NEVER commit secrets.env to Git!

# ============================================================================
# BORG BACKUP CREDENTIALS
# ============================================================================
# Borg repository encryption passphrase
# Used by all profiles for repository encryption
# SECURITY: This is the master key for your encrypted backups!
#           Without this passphrase, backups are unrecoverable!
#           Store a backup copy in a password manager or secure location!
export BORG_PASSPHRASE="REPLACE-WITH-YOUR-BORG-PASSPHRASE"

# ============================================================================
# HARDWARE CREDENTIALS
# ============================================================================
# Shelly Plug IP address (for external HDD power control)
# Used by: system profile (segment 03 and 13)
# Format: IPv4 address (e.g., 192.168.1.100)
export SHELLY_IP="192.168.X.X"

# ============================================================================
# NEXTCLOUD / DATABASE CREDENTIALS
# ============================================================================
# Nextcloud database password
# Used by: dev-data profile (pre_01_nextcloud_db_dump.sh)
# Must match the password configured in your Nextcloud database container
export NEXTCLOUD_DB_PASSWORD="REPLACE-WITH-YOUR-DB-PASSWORD"

# ============================================================================
# RECOVERY / EXPORT CREDENTIALS
# ============================================================================
# Password for recovery key ZIP archives
# Used by: All profiles (post_*_export_recovery_keys.sh)
# Optional: Leave empty for unencrypted ZIPs (not recommended)
export RECOVERY_ZIP_PASSWORD="REPLACE-WITH-YOUR-ZIP-PASSWORD"

# ============================================================================
# SECURITY NOTES
# ============================================================================
# This file contains all secrets for the backup system.
# 
# Required security measures:
# - File permissions: chmod 600 (read/write only by owner)
# - File ownership: chown root:root (owned by root)
# - Git exclusion: Must be in .gitignore (NEVER commit!)
# - Backup: Store encrypted copy in safe location
# 
# Verification commands:
#   ls -la /opt/backup-system/config/secrets.env
#   # Should show: -rw------- 1 root root
#
#   git status
#   # Should NOT show secrets.env as modified/untracked
#
# Backup recommendations:
# 1. Password manager (BitWarden, LastPass, 1Password)
# 2. Encrypted USB drive (stored offsite)
# 3. Encrypted cloud storage (Nextcloud, Dropbox with GPG)
# 4. Paper copy in safe/lockbox (for disaster recovery)
#
# ⚠️ CRITICAL: Without secrets.env backup, encrypted repositories are lost!
